# ================================================
# E-Commerce Backend - Environment Placeholders
# ================================================
# Copy this file to .env and replace the placeholder values with your actual values.

# Server
PORT=3000
NODE_ENV=dev/production

# Database (MySQL on Database VM)
DB_HOST=[IP_ADDRESS/Domain Name]
DB_PORT=3306
DB_USER=[DB Username]
DB_PASSWORD=[DB Password]
DB_NAME=[DB Name]

# JWT
JWT_SECRET=jwt-secret-goes-here
JWT_EXPIRES_IN=7d

# CORS (Frontend public IP/domain)
CORS_ORIGIN=[IP_ADDRESS]
